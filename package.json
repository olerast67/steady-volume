{
  "name": "steady-volume",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that boosts and levels the volume of video and audio on any site",
  "license": "MIT",
  "scripts": {
    "lint": "web-ext lint --source-dir src",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest --filename steady-volume-{version}.zip",
    "start:firefox": "web-ext run --source-dir src --start-url http://127.0.0.1:8765/test/player.html",
    "icons": "python scripts/make-icons.py",
    "serve": "node test/serve.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0",
    "web-ext": "^10.7.0"
  }
}
